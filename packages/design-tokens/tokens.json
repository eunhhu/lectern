      "500": { "$value": { "colorSpace": "srgb", "components": [0.149, 0.5961, 0.3961], "hex": "#269865" } },
      "600": { "$value": { "colorSpace": "srgb", "components": [0.0431, 0.4745, 0.3059], "hex": "#0b794e" } }
    },
    "yellow": {
