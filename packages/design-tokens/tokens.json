      "650": { "$value": { "colorSpace": "srgb", "components": [0.349, 0.3647, 0.3922], "hex": "#595d64" } },
      "800": { "$value": { "colorSpace": "srgb", "components": [0.1647, 0.1686, 0.1882], "hex": "#2a2b30" } },
      "850": { "$value": { "colorSpace": "srgb", "components": [0.1333, 0.1373, 0.1529], "hex": "#222327" } },
      "900": { "$value": { "colorSpace": "srgb", "components": [0.102, 0.1059, 0.1176], "hex": "#1a1b1e" } },
      "925": { "$value": { "colorSpace": "srgb", "components": [0.0784, 0.0824, 0.0863], "hex": "#141516" } },
      "950": { "$value": { "colorSpace": "srgb", "components": [0.0588, 0.0627, 0.0667], "hex": "#0f1011" } }
    },
    "indigo": {
      "300": { "$value": { "colorSpace": "srgb", "components": [0.6039, 0.6353, 0.9608], "hex": "#9aa2f5" } },
      "400": { "$value": { "colorSpace": "srgb", "components": [0.4431, 0.502, 0.9176], "hex": "#7180ea" } },
      "500": { "$value": { "colorSpace": "srgb", "components": [0.3686, 0.4157, 0.8235], "hex": "#5e6ad2" } },
      "600": { "$value": { "colorSpace": "srgb", "components": [0.3333, 0.3765, 0.7804], "hex": "#5560c7" } }
    },
    "green": {
