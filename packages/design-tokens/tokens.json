      "solid-hover": {
        "$description": "주요 버튼 hover. 흰 글자 대비를 지키려고 두 테마 모두 한 단계 어둡게 간다.",
        "$value": "{palette.indigo.600}",
        "$extensions": { "com.qucord.lectern": { "modes": { "dark": "{palette.indigo.600}" } } }
