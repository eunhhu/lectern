          "$value": "{palette.green.600}",
          "$extensions": { "com.qucord.lectern": { "modes": { "dark": "{palette.green.400}" } } }
        },
        "ui": {
          "$description": "상태 점, 진행 막대, 아이콘. 채움색을 뺀 모든 표면 위에서 3:1 이상.",
          "$value": "{palette.green.500}",
          "$extensions": { "com.qucord.lectern": { "modes": { "dark": "{palette.green.400}" } } }
        },
        "subtle": {
