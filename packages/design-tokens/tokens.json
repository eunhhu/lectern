      "500": { "$value": { "colorSpace": "srgb", "components": [0.6431, 0.5098, 0.0118], "hex": "#a48203" } },
      "600": { "$value": { "colorSpace": "srgb", "components": [0.5333, 0.3961, 0.0078], "hex": "#886502" } }
    },
    "orange": {
      "400": { "$value": { "colorSpace": "srgb", "components": [0.949, 0.6, 0.2902], "hex": "#f2994a" } },
      "500": { "$value": { "colorSpace": "srgb", "components": [0.7765, 0.4431, 0.0863], "hex": "#c67116" } },
      "600": { "$value": { "colorSpace": "srgb", "components": [0.651, 0.3294, 0.0157], "hex": "#a65404" } }
    },
    "red": {
      "300": { "$value": { "colorSpace": "srgb", "components": [0.9686, 0.3843, 0.3765], "hex": "#f76260" } },
      "400": { "$value": { "colorSpace": "srgb", "components": [0.9059, 0.3294, 0.3294], "hex": "#e75454" } },
      "500": { "$value": { "colorSpace": "srgb", "components": [0.8118, 0.2353, 0.2353], "hex": "#cf3c3c" } },
      "600": { "$value": { "colorSpace": "srgb", "components": [0.7686, 0.2, 0.2118], "hex": "#c43336" } }
    },
    "blue": {
      "400": { "$value": { "colorSpace": "srgb", "components": [0.3059, 0.6549, 0.9882], "hex": "#4ea7fc" } },
      "500": { "$value": { "colorSpace": "srgb", "components": [0.1804, 0.5412, 0.8667], "hex": "#2e8add" } },
      "600": { "$value": { "colorSpace": "srgb", "components": [0.0588, 0.4196, 0.7569], "hex": "#0f6bc1" } }
    }
  },
  "color": {
    "$type": "color",
    "bg": {
      "$description": "표면(배경). 아래에서 위로 canvas → panel → raised 순으로 쌓는다.",
      "canvas": {
        "$description": "앱 바탕. 사이드바와 페이지 배경.",
        "$value": "{palette.neutral.10}",
        "$extensions": { "com.qucord.lectern": { "modes": { "dark": "{palette.neutral.950}" } } }
      },
      "panel": {
        "$description": "주 작업 영역(목록, 본문)의 배경.",
        "$value": "{palette.neutral.0}",
        "$extensions": { "com.qucord.lectern": { "modes": { "dark": "{palette.neutral.925}" } } }
      },
      "raised": {
        "$description": "패널 위에 뜨는 표면: 카드, 상세 패널, 다이얼로그, 팔레트, 토스트, 보조 버튼.",
        "$value": "{palette.neutral.0}",
        "$extensions": { "com.qucord.lectern": { "modes": { "dark": "{palette.neutral.900}" } } }
      },
      "raised-hover": {
        "$description": "raised 표면 버튼의 hover.",
        "$value": "{palette.neutral.50}",
        "$extensions": { "com.qucord.lectern": { "modes": { "dark": "{palette.neutral.850}" } } }
      },
      "control-selected": {
        "$description": "세그먼트·탭 선택 상태의 엄지(thumb).",
        "$value": "{palette.neutral.0}",
        "$extensions": { "com.qucord.lectern": { "modes": { "dark": "{palette.neutral.800}" } } }
      },
      "input": {
        "$description": "입력 필드 배경.",
        "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" },
        "$extensions": {
          "com.qucord.lectern": {
            "modes": { "dark": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.025, "hex": "#ffffff" } }
          }
        }
      },
      "hover": {
        "$description": "행·메뉴 항목 hover. 아래 표면 위에 겹쳐 칠한다.",
        "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.035, "hex": "#000000" },
        "$extensions": {
          "com.qucord.lectern": {
            "modes": { "dark": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.04, "hex": "#ffffff" } }
          }
        }
      },
      "active": {
        "$description": "키보드 선택 행, 활성 메뉴, 켜진 칩. 진행 막대·스위치의 빈 트랙.",
        "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.055, "hex": "#000000" },
        "$extensions": {
          "com.qucord.lectern": {
            "modes": { "dark": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.07, "hex": "#ffffff" } }
          }
        }
      },
      "selected": {
        "$description": "열린 항목(상세 패널에 표시 중인 행), 강조 배지, 텍스트 선택 영역.",
        "$value": { "colorSpace": "srgb", "components": [0.3686, 0.4157, 0.8235], "alpha": 0.12, "hex": "#5e6ad2" },
        "$extensions": {
          "com.qucord.lectern": {
            "modes": {
              "dark": { "colorSpace": "srgb", "components": [0.3686, 0.4157, 0.8235], "alpha": 0.18, "hex": "#5e6ad2" }
            }
          }
        }
      },
      "scrim": {
        "$description": "모달·서랍 뒤를 덮는 막.",
        "$value": { "colorSpace": "srgb", "components": [0.0588, 0.0627, 0.0667], "alpha": 0.22, "hex": "#0f1011" },
        "$extensions": {
          "com.qucord.lectern": {
            "modes": { "dark": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.55, "hex": "#000000" } }
          }
        }
      }
    },
    "border": {
      "subtle": {
        "$description": "행·섹션 구분선. 장식용이며 컴포넌트를 식별하는 유일한 단서로 쓰지 않는다.",
        "$value": "{palette.neutral.100}",
        "$extensions": {
          "com.qucord.lectern": {
            "modes": { "dark": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.07, "hex": "#ffffff" } }
          }
        }
      },
      "default": {
        "$description": "카드, 보조 버튼, 입력 필드, 배지의 외곽선. 장식용.",
        "$value": "{palette.neutral.150}",
        "$extensions": {
          "com.qucord.lectern": {
            "modes": { "dark": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.11, "hex": "#ffffff" } }
          }
        }
      },
      "control": {
        "$description": "외곽선이 유일한 식별 단서인 컨트롤(체크박스, 라디오, 레이블 없는 입력). 3:1 이상.",
        "$value": "{palette.neutral.500}",
        "$extensions": { "com.qucord.lectern": { "modes": { "dark": "{palette.neutral.550}" } } }
      },
      "focus": {
        "$description": "키보드 포커스 링과 선택 행 표시줄. 3:1 이상.",
        "$value": "{palette.indigo.600}",
        "$extensions": { "com.qucord.lectern": { "modes": { "dark": "{palette.indigo.400}" } } }
      }
    },
    "text": {
      "primary": {
        "$description": "본문, 제목, 값. 채움색을 뺀 모든 표면 위에서 4.5:1 이상.",
        "$value": "{palette.neutral.900}",
        "$extensions": { "com.qucord.lectern": { "modes": { "dark": "{palette.neutral.25}" } } }
      },
      "secondary": {
        "$description": "보조 설명, 레이블, 열 값. 채움색을 뺀 모든 표면 위에서 4.5:1 이상.",
        "$value": "{palette.neutral.650}",
        "$extensions": { "com.qucord.lectern": { "modes": { "dark": "{palette.neutral.400}" } } }
      },
      "tertiary": {
        "$description": "개수, 힌트, 타임스탬프, 자리표시자. 채움색을 뺀 모든 표면 위에서 4.5:1 이상.",
