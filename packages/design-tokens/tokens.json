        "$extensions": { "com.qucord.lectern": { "modes": { "dark": "{palette.neutral.0}" } } }
      }
    },
    "accent": {
      "$description": "브랜드 강조색(인디고). 주요 동작, 선택, 링크성 글자에만 쓴다.",
      "solid": {
        "$description": "주요 버튼, 켜진 스위치, 진행 막대 채움, 로고.",
