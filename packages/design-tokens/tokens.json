      "fg": {
        "$description": "강조 글자(소유자 배지, 강조 수치, 링크성 글자).",
        "$value": "{palette.indigo.600}",
        "$extensions": { "com.qucord.lectern": { "modes": { "dark": "{palette.indigo.300}" } } }
      },
      "border": {
        "$description": "강조 배지 테두리. 장식용.",
        "$value": { "colorSpace": "srgb", "components": [0.3686, 0.4157, 0.8235], "alpha": 0.45, "hex": "#5e6ad2" },
        "$extensions": {
          "com.qucord.lectern": {
            "modes": {
              "dark": { "colorSpace": "srgb", "components": [0.3686, 0.4157, 0.8235], "alpha": 0.45, "hex": "#5e6ad2" }
