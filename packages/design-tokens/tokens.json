          "$value": { "colorSpace": "srgb", "components": [0.149, 0.5961, 0.3961], "alpha": 0.35, "hex": "#269865" },
          "$extensions": {
            "com.qucord.lectern": {
              "modes": {
                "dark": { "colorSpace": "srgb", "components": [0.298, 0.7176, 0.5098], "alpha": 0.35, "hex": "#4cb782" }
              }
            }
          }
        }
      },
      "attention": {
        "$description": "대기, 진행 중, 확인 필요.",
        "fg": {
          "$description": "상태 글자와 작은 아이콘. 채움색을 뺀 모든 표면 위에서 4.5:1 이상.",
          "$value": "{palette.yellow.600}",
          "$extensions": { "com.qucord.lectern": { "modes": { "dark": "{palette.yellow.300}" } } }
        },
        "ui": {
          "$description": "상태 점, 진행 막대, 아이콘. 채움색을 뺀 모든 표면 위에서 3:1 이상.",
          "$value": "{palette.yellow.500}",
          "$extensions": { "com.qucord.lectern": { "modes": { "dark": "{palette.yellow.300}" } } }
        },
        "subtle": {
          "$description": "상태 안내 상자(callout)의 옅은 배경.",
          "$value": { "colorSpace": "srgb", "components": [0.6431, 0.5098, 0.0118], "alpha": 0.12, "hex": "#a48203" },
          "$extensions": {
            "com.qucord.lectern": {
              "modes": {
                "dark": { "colorSpace": "srgb", "components": [0.949, 0.7882, 0.298], "alpha": 0.08, "hex": "#f2c94c" }
              }
            }
          }
        },
        "border": {
          "$description": "상태 배지·안내 상자의 테두리. 장식용.",
          "$value": { "colorSpace": "srgb", "components": [0.6431, 0.5098, 0.0118], "alpha": 0.35, "hex": "#a48203" },
          "$extensions": {
            "com.qucord.lectern": {
              "modes": {
                "dark": { "colorSpace": "srgb", "components": [0.949, 0.7882, 0.298], "alpha": 0.35, "hex": "#f2c94c" }
