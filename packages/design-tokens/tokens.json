{
  "$description": "Lectern 디자인 토큰의 단일 진실 공급원(W3C DTCG 2025.10). `bun run tokens:build`로 dist/를 다시 만든다. 규칙과 사용법은 저장소 루트의 DESIGN.md.",
  "$extensions": {
    "com.qucord.lectern": {
      "modes": ["light", "dark"],
      "contrast": {
        "surfaces": {
          "base": [
            ["color.bg.canvas"],
            ["color.bg.canvas", "color.bg.hover"],
            ["color.bg.canvas", "color.bg.active"],
            ["color.bg.panel"],
            ["color.bg.panel", "color.bg.hover"],
            ["color.bg.panel", "color.bg.active"],
            ["color.bg.panel", "color.bg.selected"],
            ["color.bg.panel", "color.bg.input"],
            ["color.bg.raised"],
            ["color.bg.raised", "color.bg.hover"],
            ["color.bg.raised", "color.bg.active"],
            ["color.bg.raised", "color.bg.selected"],
            ["color.bg.raised", "color.bg.input"]
          ],
          "emphasis": [["color.bg.raised-hover"], ["color.bg.control-selected"]],
          "tinted": [
            ["color.bg.panel", "color.status.success.subtle"],
            ["color.bg.raised", "color.status.success.subtle"],
            ["color.bg.panel", "color.status.attention.subtle"],
            ["color.bg.raised", "color.status.attention.subtle"],
            ["color.bg.panel", "color.status.severe.subtle"],
            ["color.bg.raised", "color.status.severe.subtle"],
            ["color.bg.panel", "color.status.danger.subtle"],
            ["color.bg.raised", "color.status.danger.subtle"],
            ["color.bg.panel", "color.status.info.subtle"],
            ["color.bg.raised", "color.status.info.subtle"]
          ],
          "solid": [
            ["color.accent.solid"],
            ["color.accent.solid-hover"],
            ["color.status.danger.solid"],
            ["color.status.danger.solid-hover"]
          ],
          "opaque": [["color.bg.canvas"], ["color.bg.panel"], ["color.bg.raised"]]
        },
        "pairs": [
          { "role": "text", "min": 4.5, "fg": ["color.text.primary"], "on": ["base", "emphasis", "tinted"] },
          {
            "role": "text",
            "min": 4.5,
            "fg": ["color.text.secondary", "color.text.tertiary", "color.accent.fg", "color.status.*.fg"],
            "on": ["base", "emphasis", "tinted"]
          },
          { "role": "text", "min": 4.5, "fg": ["color.text.on-solid"], "on": ["solid"] },
          {
            "role": "ui",
            "min": 3,
            "fg": ["color.border.focus", "color.border.control", "color.status.*.ui"],
            "on": ["base", "emphasis", "tinted"]
          },
          { "role": "ui", "min": 3, "fg": ["color.accent.solid", "color.status.danger.solid"], "on": ["opaque"] }
        ],
        "exempt": {
          "color.border.subtle": "장식용 구분선",
          "color.border.default": "장식용 외곽선(컴포넌트는 글자·배경으로 식별된다)",
          "color.accent.border": "장식용 배지 테두리",
          "color.status.*.border": "장식용 배지·안내 상자 테두리",
          "color.text.disabled": "비활성 UI는 WCAG 1.4.3·1.4.11 예외",
          "color.bg.scrim": "모달 뒤 막. 글자를 올리지 않는다"
        }
      }
    }
  },
  "palette": {
    "$description": "원시 팔레트. 출력 파일로 내보내지 않으며, 의미 토큰(color.*)만 이 값을 참조한다.",
    "$type": "color",
    "$extensions": { "com.qucord.lectern": { "export": false } },
    "neutral": {
      "0": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" } },
      "10": { "$value": { "colorSpace": "srgb", "components": [0.9843, 0.9843, 0.9843], "hex": "#fbfbfb" } },
      "25": { "$value": { "colorSpace": "srgb", "components": [0.9686, 0.9725, 0.9725], "hex": "#f7f8f8" } },
      "50": { "$value": { "colorSpace": "srgb", "components": [0.9569, 0.9569, 0.9608], "hex": "#f4f4f5" } },
      "100": { "$value": { "colorSpace": "srgb", "components": [0.9098, 0.9098, 0.9176], "hex": "#e8e8ea" } },
      "150": { "$value": { "colorSpace": "srgb", "components": [0.8627, 0.8627, 0.8784], "hex": "#dcdce0" } },
      "400": { "$value": { "colorSpace": "srgb", "components": [0.6118, 0.6314, 0.6667], "hex": "#9ca1aa" } },
      "450": { "$value": { "colorSpace": "srgb", "components": [0.5608, 0.5804, 0.6157], "hex": "#8f949d" } },
