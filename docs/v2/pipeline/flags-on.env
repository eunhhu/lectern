# Flags the build gate turns on for its second preflight run (scripts/pipeline/gate.sh).
# One NAME=value per line. A contract work package that adds a feature flag appends it here,
# so "everything on" keeps being checked. Never put secrets in this file.
LECTERN_WEB_SHELL=1
LECTERN_ASK=1
LECTERN_PDF=1
LECTERN_TRANSCRIPT_ENGINE=shadow
LECTERN_DISTILL_ENGINE=harness
LECTERN_PIPELINE=v2
LECTERN_CALENDAR=1
LECTERN_GOOGLE_LOGIN=1
LECTERN_APPLE_LOGIN=1
LECTERN_TEAMS=1
