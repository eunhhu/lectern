{
  "name": "lectern",
  "version": "1.0.0",
  "private": true,
  "description": "Zero-overhead cross-platform lecture audio recorder, noise/break filter, and academic Markdown distillation engine powered by Bun & Gemini Flash.",
  "workspaces": [
    "packages/*",
    "apps/server",
    "apps/worker",
    "apps/web"
  ],
  "scripts": {
    "dev": "bun --watch apps/server/src/index.ts",
    "start": "bun apps/server/src/index.ts",
    "cli": "bun packages/core/src/cli.ts",
    "harness": "bun packages/harness/src/cli.ts",
    "domain:openapi": "bun packages/domain/scripts/openapi.ts",
    "test": "bun test",
    "typecheck": "bun x tsc --noEmit",
    "config:docs": "bun packages/config/scripts/write-env-docs.ts",
    "tokens:build": "bun packages/design-tokens/scripts/build.ts",
    "web:build": "bun run --cwd apps/web build",
    "web:dev": "bun run --cwd apps/web dev",
    "web:e2e": "bun run --cwd apps/web e2e",
    "pipeline": "bun scripts/pipeline/pipeline.ts",
    "gate": "bash scripts/pipeline/gate.sh"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  }
}
