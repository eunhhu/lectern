# /etc/lectern/lectern.env — EnvironmentFile for lectern.service and lectern-worker.service.
#
# Copy to /etc/lectern/lectern.env, fill in the real values on the host, then
#   sudo chown root:root /etc/lectern/lectern.env && sudo chmod 600 /etc/lectern/lectern.env
# systemd reads the file as root before it drops to User=eunhhu, so the service user
# needs no read access. Never commit the filled-in file. Every value below is a safe
# placeholder. See docs/runbooks/host-setup.md and docs/runbooks/secret-rotation.md.
#
# Format: systemd EnvironmentFile. One KEY=value per line, no `export`, `#` comments
# only at the start of a line, quote values that contain spaces. An empty value means
# "unset" (packages/config treats empty and missing the same).
#
# packages/config/src/index.ts is the source of truth for names, defaults and
# validation; docs/env.md is generated from it. Add or rename a variable there and here
# in the same PR. An invalid value stops the server at boot (and fails the CD preflight).

# --- Network ---------------------------------------------------------------------
# The server binds 127.0.0.1 only; the reverse proxy in front of it connects here.
PORT=18775
# Public origin, used in share links and emails. An http:// value turns off the Secure
# flag on the session cookie (local development only).
LECTERN_BASE_URL=https://lectern.qucord.com
# Trusted proxies that append to X-Forwarded-For. Count them on the host
# (docs/runbooks/host-setup.md, step "프록시 확인"): Cloudflare -> local proxy -> server
# is 2. A wrong value makes per-IP rate limits key on a proxy or edge address.
LECTERN_TRUSTED_PROXY_HOPS=1

# --- Paths -----------------------------------------------------------------------
# Set all three explicitly in production. The code defaults are <repo>/data and
# <repo>/lectures, which are not where the production lecture archive lives.
#
# Checkout the CD webhook hard-resets to the deployed commit (deploys are refused
# without it, unless the legacy path exists).
LECTERN_REPO_DIR=/home/eunhhu/work/lectern
# SQLite database, uploads/, trash/, backups/. Today this sits inside the deploy
# checkout (ignored by git): never run `git clean -fdx` there.
LECTERN_DATA_DIR=/home/eunhhu/work/lectern/data
# The owner's lecture archive (Markdown + `_원본` audio), synced into the library at boot.
LECTERN_LECTURES_DIR=/home/eunhhu/work/lectures

# --- Processes and logging -------------------------------------------------------------
# embedded: the API process also runs the job worker (until lectern-worker.service is
# installed). external: only apps/worker runs jobs. Switch to external in the same step
# that enables lectern-worker.service (docs/runbooks/host-setup.md).
LECTERN_WORKER_MODE=embedded
# json for journald (production); pretty for local development.
LECTERN_LOG_FORMAT=json
# 1/0 (or true/false). Credentials in query strings are redacted either way.
LECTERN_LOG_REQUESTS=1
# 1: serve the new web app at /app (apps/web/dist). Off until the CD release builds it:
# the deploy is a git checkout without a build step, so /app answers 503 while
# apps/web/dist is missing (run `bun run web:build` in the checkout first).
LECTERN_WEB_SHELL=0
# Running jobs get this long on SIGTERM or a deploy. Keep the units' TimeoutStopSec
# (40s) above this value + 5s.
LECTERN_SHUTDOWN_GRACE_SEC=20

# --- Secrets ---------------------------------------------------------------------
# Left empty on purpose: an empty secret fails safe (deploys answer 401, AI jobs and
# emails fail with a clear error) instead of running with a guessable placeholder.
# Fill them in on the host only.
#
# Shared secret for POST /api/cd/deploy; must equal the GitHub Actions secret
# LECTERN_DEPLOY_TOKEN. Generate with: openssl rand -hex 32
LECTERN_DEPLOY_TOKEN=
# Gemini API key from a Google Cloud project with billing enabled (Paid Services, so
# prompts and files are not used to improve Google's products). When empty, the code
# falls back to GEMINI_API_KEY= in the service user's ~/local.env; once it is set here,
# delete that copy.
GEMINI_API_KEY=
# Resend API key (starts with re_) for verification and password-reset emails. When it
# is set, the credentials file below is never read.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Lectern <noreply@qucord.com>"
# Fallback JSON file with resend.api_key, read only while RESEND_API_KEY is empty.
# Empty here means the legacy path in the owner's home directory.
LECTERN_RESEND_CREDENTIALS_FILE=

# --- Policy pages ------------------------------------------------------------------
# Filled into /privacy and /terms at serve time, so these values never enter the public
# repository. Unset values show neutral text ("추후 공고") instead of a blank slot, but
# Google OAuth verification needs all three (docs/runbooks/google-oauth-verification.md).
# Use a role address (privacy@ or support@ on the service domain), not a personal one.
LECTERN_LEGAL_CONTACT_EMAIL=
LECTERN_LEGAL_OFFICER_NAME=
# YYYY-MM-DD. A change that adds collected data needs 30 days' notice before this date.
LECTERN_LEGAL_EFFECTIVE_DATE=

# --- Owner bootstrap ---------------------------------------------------------------
# The owner's login email. When set, an existing account with this email is promoted
# to owner, but an email with NO account creates a second owner account, so it must
# match the live owner's login email exactly. When empty, the oldest existing owner is
# kept (on an empty database an owner@lectern.local account is created).
LECTERN_OWNER_EMAIL=
LECTERN_OWNER_NAME="Workspace Owner"
# Comma-separated login names that resolve to LECTERN_OWNER_EMAIL (optional).
LECTERN_OWNER_ALIASES=
# Leave empty in normal operation. Used only when the owner account is created (empty
# means a random password; sign in through the password-reset email), or for a one-off
# reset together with LECTERN_FORCE_RESET_OWNER_PASSWORD=1 and LECTERN_OWNER_EMAIL
# (docs/runbooks/secret-rotation.md). Clear both lines again after that restart.
LECTERN_OWNER_PASSWORD=
LECTERN_FORCE_RESET_OWNER_PASSWORD=0
# Fixed API token for a NEW owner account only; ignored once the owner exists.
LECTERN_OWNER_API_TOKEN=

# --- AI ----------------------------------------------------------------------------
# Pinned model id (never a -latest alias). Requests may only pick the default model or
# ids added to the comma-separated allowlist.
LECTERN_GEMINI_MODEL=gemini-3.8-flash
LECTERN_GEMINI_ALLOWED_MODELS=
# Deadline for one generateContent call, in ms (60000-3600000).
LECTERN_GEMINI_TIMEOUT_MS=900000
# Which code runs distill jobs. legacy: the job handler calls packages/core directly.
# harness: the same Gemini call runs as one stage on packages/harness, which records
# stage_run, artifact and ai_call (token cost) rows and resumes an interrupted job
# without paying for a second Gemini call. Same results and events either way.
LECTERN_DISTILL_ENGINE=legacy
# v2 transcript pipeline (packages/harness, docs/v2/AI_HARNESS.md §11 step 3).
# off: not run. shadow: after a distill on the server key succeeds, a separate
# `transcribe` job runs ingest → normalize → speech_map → chunk → transcribe → merge →
# speakers and keeps the transcript as a harness artifact that no user sees (a second
# Gemini pass, about $0.2 per hour of audio, capped per job; needs ffmpeg 5.1+). The
# artifacts go with the recording or its audio, or 30 days after the job.
# on: will publish the transcript to the recording once the transcript tables exist;
# until then it runs exactly like shadow.
LECTERN_TRANSCRIPT_ENGINE=off
# 물어보기 (docs/adr/0009-ask-rag.md). 1 indexes every user's lectures (embeddings via
# Gemini, about $0.003 per hour of notes) and serves /api/v2/ask (about $0.002 a question).
# Per-workspace monthly budget in micro-USD: 2000000 = $2. 0 blocks asking.
LECTERN_ASK=0
LECTERN_ASK_MONTHLY_LIMIT_MICROUSD=2000000

# --- Jobs, maintenance, storage ------------------------------------------------------
LECTERN_MAX_CONCURRENT_JOBS=2
LECTERN_MAX_CONCURRENT_COMPACT=1
# How long a worker's claim on a job lasts without a heartbeat before another worker
# reclaims it (ms), and how often workers poll for new jobs (ms).
LECTERN_JOB_LEASE_TTL_MS=60000
LECTERN_JOB_POLL_MS=1000
LECTERN_MAINTENANCE_INTERVAL_MIN=60
LECTERN_BACKUP_INTERVAL_HOURS=24
LECTERN_BACKUP_KEEP=7
LECTERN_TRASH_DAYS=7

# Not for this file: LECTERN_PREFLIGHT, LECTERN_TEST_SANDBOX and HOME are set by the
# deploy preflight and the test preload. The preflight inherits this environment but
# blanks the secrets and points the data paths at a temporary copy.
